# Copy this file to .env and fill in your values. .env is gitignored.

# Required
DISCORD_TOKEN=your-discord-bot-token
ANTHROPIC_API_KEY=your-anthropic-api-key

# Where the message history is stored (local SQLite file)
DATABASE_PATH=server_memory.db

# --- Moderation (optional) ---
# Turn on AI moderation. Off by default because it calls the Claude API on
# every message (cost + rate limits). Read the README before enabling.
MODERATION_ENABLED=false
# Channel ID where flagged messages are reported (right-click a channel -> Copy ID)
MOD_LOG_CHANNEL_ID=
# Mute duration (Discord timeout) for threats/abuse, scaled by severity, in
# minutes. Each value is capped at 3 days (4320 min) regardless of what you set.
MUTE_MINUTES_LOW=30        # 30 minutes
MUTE_MINUTES_MEDIUM=360    # 6 hours
MUTE_MINUTES_HIGH=4320     # 3 days

# --- Data retention ---
# Stored messages older than this are automatically deleted (privacy).
RETENTION_DAYS=3

# --- Models ---
# Defaults to Claude Opus 4.8. For high-volume servers you can switch the
# moderation classifier to a cheaper/faster model, e.g. claude-haiku-4-5.
ANSWER_MODEL=claude-opus-4-8
MODERATION_MODEL=claude-opus-4-8
